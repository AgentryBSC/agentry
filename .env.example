# 部署账户私钥，不要提交真实值
PRIVATE_KEY=

# BscScan API Key，用于合约源码验证
BSCSCAN_API_KEY=

# RPC（留空则用默认公共节点）
BSC_RPC=
BSC_TESTNET_RPC=

# ---- 内容服务 ----
# IPFS 固定。两者都配时 kubo 优先。
#
# kubo（推荐）：add 参数可精确控制，返回的 CID 必然和本地算的一致
IPFS_API=
IPFS_AUTH=
#
# Pinata：不暴露 raw-leaves 开关，CID 有可能对不上。
# 真对不上会当场报错，不会静默接受
PINATA_JWT=

# 内容存储目录，默认 ./.content
CONTENT_DIR=
